        {
          "FormKey": "1A2B12:Fallout4.esm",
          "VersionControl": 10281,
          "Version2": 3,
          "Flags": {
            "Flags": [
              "Random"
            ]
          },
          "PreviousDialog": "1A2B11:Fallout4.esm",
          "DialogGroup": "1A2B0D:Fallout4.esm",
          "Responses": [
            {
              "Emotion": "0FA847:Fallout4.esm",
              "ResponseNumber": 1,
              "CameraTargetAlias": -1,
              "CameraLocationAlias": -1,
              "Text": {
                "TargetLanguage": "English",
                "Value": "Always happy to spend some time with my friend. Even when the grenades and bullets are flying. Which happens an awful lot."
              },
              "ScriptNotes": "Banter with Deacon's best friend",
              "Edits": "",
              "AlternateLipText": "",
              "TextHash": "0x5092E8174E4DD001"
            }
          ],
          "StartScenePhase": "",
          "SubtitlePriority": "Low"
        },
        {
          "FormKey": "025AAD:PiperCaitCurieDialogueOverhaul.esp",
          "VersionControl": 10281,
          "Flags": {
            "Flags": [
              "Random"
            ]
          },
          "PreviousDialog": "1A2B12:Fallout4.esm",
          "DialogGroup": "1A2B0D:Fallout4.esm",
          "Responses": [
            {
              "Emotion": "0D755D:Fallout4.esm",
              "ResponseNumber": 1,
              "CameraTargetAlias": -1,
              "CameraLocationAlias": -1,
              "Text": {
                "TargetLanguage": "English",
                "Value": "What do friends do together these days, anyway? Poker? Camp fires? Mani petis?"
              },
              "ScriptNotes": "Banter with Deacon's best friend",
              "Edits": "",
              "AlternateLipText": "",
              "TextHash": "0x906A25A12CC7D501"
            }
          ],
          "StartScenePhase": "",
          "SubtitlePriority": "Low"
        },
        {
          "FormKey": "025AAE:PiperCaitCurieDialogueOverhaul.esp",
          "VersionControl": 10281,
          "Flags": {
            "Flags": [
              "Random"
            ]
          },
          "PreviousDialog": "025AAD:PiperCaitCurieDialogueOverhaul.esp",
          "DialogGroup": "1A2B0D:Fallout4.esm",
          "Responses": [
            {
              "Emotion": "0FA84D:Fallout4.esm",
              "ResponseNumber": 1,
              "CameraTargetAlias": -1,
              "CameraLocationAlias": -1,
              "Text": {
                "TargetLanguage": "English",
                "Value": "Did I have you going about being a synth? You'd be amazed at how many people fall for that."
              },
              "ScriptNotes": "Banter with Deacon's best friend",
              "Edits": "",
              "AlternateLipText": "",
              "TextHash": "0xE0F9F5E12CC7D501"
            }
          ],
          "StartScenePhase": "",
          "SubtitlePriority": "Low"
        },
        {
          "FormKey": "025AAF:PiperCaitCurieDialogueOverhaul.esp",
          "VersionControl": 10281,
          "Flags": {
            "Flags": [
              "Random"
            ]
          },
          "PreviousDialog": "025AAE:PiperCaitCurieDialogueOverhaul.esp",
          "DialogGroup": "1A2B0D:Fallout4.esm",
          "Responses": [
            {
              "Emotion": "0FA84D:Fallout4.esm",
              "ResponseNumber": 1,
              "CameraTargetAlias": -1,
              "CameraLocationAlias": -1,
              "Text": {
                "TargetLanguage": "English",
                "Value": "Since we're a team, you think we could use a code name? Red Orchard? Or... Code Violet? Or... the Death Bunnies. That'll confuse them."
              },
              "ScriptNotes": "Banter with Deacon's best friend",
              "Edits": "",
              "AlternateLipText": "",
              "TextHash": "0xB0D240FD2CC7D501"
            }
          ],
          "StartScenePhase": "",
          "SubtitlePriority": "Low"
        },
        {
          "FormKey": "025AB0:PiperCaitCurieDialogueOverhaul.esp",
          "VersionControl": 10281,
          "Flags": {
            "Flags": [
              "Random"
            ]
          },
          "PreviousDialog": "025AAF:PiperCaitCurieDialogueOverhaul.esp",
          "DialogGroup": "1A2B0D:Fallout4.esm",
          "Responses": [
            {
              "Emotion": "0D755D:Fallout4.esm",
              "ResponseNumber": 1,
              "CameraTargetAlias": -1,
              "CameraLocationAlias": -1,
              "Text": {
                "TargetLanguage": "English",
                "Value": "I'm new to this \"friends\" thing. There's perks right? Like, can I take out a loan? Say, 100,000 caps. I'll get it back to you. Promise."
              },
              "ScriptNotes": "Banter with Deacon's best friend",
              "Edits": "",
              "AlternateLipText": "",
              "TextHash": "0xE02399192DC7D501"
            }
          ],
          "StartScenePhase": "",
          "SubtitlePriority": "Low"
        }
      ]
