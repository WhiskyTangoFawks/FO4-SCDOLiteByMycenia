            {
              "Emotion": "0FA84D:Fallout4.esm",
              "ResponseNumber": 1,
              "CameraTargetAlias": -1,
              "CameraLocationAlias": -1,
              "Text": {
                "TargetLanguage": "English",
                "Value": "You and me are just fine. Not many people are in my good book. Well, it's more like a pamphlet, really."
              },
              "ScriptNotes": "You're talking to a good friend.",
              "Edits": "",
              "AlternateLipText": "",
              "TextHash": "0xC09583D64E4DD001"
            }
          ],
          "StartScenePhase": "",
          "SubtitlePriority": "Low"
        },
        {
          "FormKey": "025AAA:PiperCaitCurieDialogueOverhaul.esp",
          "VersionControl": 10281,
          "Flags": {
            "Flags": [
              "Random"
            ]
          },
          "PreviousDialog": "1A2B1D:Fallout4.esm",
          "DialogGroup": "1A2B18:Fallout4.esm",
          "Responses": [
            {
              "Emotion": "0D755D:Fallout4.esm",
              "ResponseNumber": 1,
              "CameraTargetAlias": -1,
              "CameraLocationAlias": -1,
              "Text": {
                "TargetLanguage": "English",
                "Value": "The open road isn't as bad with a buddy."
              },
              "ScriptNotes": "You're talking to a good friend.",
              "Edits": "",
              "AlternateLipText": "",
              "TextHash": "0x7015CF352CC7D501"
            }
          ],
          "StartScenePhase": "",
          "SubtitlePriority": "Low"
        },
        {
          "FormKey": "025AAB:PiperCaitCurieDialogueOverhaul.esp",
          "VersionControl": 10281,
          "Flags": {
            "Flags": [
              "Random"
            ]
          },
          "PreviousDialog": "025AAA:PiperCaitCurieDialogueOverhaul.esp",
          "DialogGroup": "1A2B18:Fallout4.esm",
          "Responses": [
            {
              "Emotion": "0D755D:Fallout4.esm",
              "ResponseNumber": 1,
              "CameraTargetAlias": -1,
              "CameraLocationAlias": -1,
              "Text": {
                "TargetLanguage": "English",
                "Value": "I'm used to running my ops solo. But this isn't too bad."
              },
              "ScriptNotes": "You're talking to a good friend.",
              "Edits": "",
              "AlternateLipText": "",
              "TextHash": "0x20686F602CC7D501"
            }
          ],
          "StartScenePhase": "",
          "SubtitlePriority": "Low"
        },
        {
          "FormKey": "025AAC:PiperCaitCurieDialogueOverhaul.esp",
          "VersionControl": 10281,
          "Flags": {
            "Flags": [
              "Random"
            ]
          },
          "PreviousDialog": "025AAB:PiperCaitCurieDialogueOverhaul.esp",
          "DialogGroup": "1A2B18:Fallout4.esm",
          "Responses": [
            {
              "Emotion": "0D755D:Fallout4.esm",
              "ResponseNumber": 1,
              "CameraTargetAlias": -1,
              "CameraLocationAlias": -1,
              "Text": {
                "TargetLanguage": "English",
                "Value": "I like the way you look out for your fellow man. A lot of people would take the easy way out."
              },
              "ScriptNotes": "You're talking to a good friend.",
              "Edits": "",
              "AlternateLipText": "",
              "TextHash": "0x6086D67C2CC7D501"
            }
          ],
          "StartScenePhase": "",
          "SubtitlePriority": "Low"
        }
      ]
    },
    {
      "FormKey": "1A2B03:Fallout4.esm",
      "VersionControl": 7769,
      "Quest": "1A2AFD:Fallout4.esm",
      "Category": "Scene",
      "Subtype": "Custom17",
